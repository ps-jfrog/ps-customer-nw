# This helper materialises the very tree that provides the shared _is_sourced,
# so it has to keep working when that helper is not on disk yet.
case "$(command -v _is_sourced 2>/dev/null)" in
    "")
        _is_sourced() {
            if [ -n "${FORCE_SOURCED:-}" ]; then
                return 0
            fi
            [ "${BASH_SOURCE[0]:-$0}" != "${0}" ]
        }
        ;;
    /*)
        # shellcheck source=/dev/null
        . _is_sourced
        ;;
esac

if ! _is_sourced; then
    set -euo pipefail
    ps_bundle_resolve "$@"
fi
