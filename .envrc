#!/bin/bash

# Run in customer env?
if [ "${1:-}" = "-live" ]; then
    export PATH="$PWD/.envrc.d:$PATH"

    if [ -d "bin" ]; then
        rm bin/output.zip
		zip -r "bin/output.zip" . -x@.zipignore
    fi
else
    source_up_if_exists
    PATH_add .envrc.d

    if [ -d "bin" ]; then
        rm bin/output.zip
		zip -r "bin/output.zip" . -x@.zipignore
    fi
fi
