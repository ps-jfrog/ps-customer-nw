#!/bin/bash

# Circuit-break re-entry. If a submodule's .envrc calls source_up_if_exists,
# direnv walks up to this file again — without a guard the load recurses
# until the stack overflows. We track a colon-separated stack of .envrc
# directories visited during this evaluation; bail if we've already entered
# this one. The variable is non-exported, so it's scoped to the direnv
# evaluation subshell and reset on every reload.
case ":${_PS_ENVRC_STACK:-}:" in
    *":$PWD:"*) return 0 ;;
esac
_PS_ENVRC_STACK="${_PS_ENVRC_STACK:+$_PS_ENVRC_STACK:}$PWD"

_load_subdir_envrcs() {
    # Convention: any direct subfolder containing an .envrc is opted in, so
    # this behaves identically in dev and customer modes. find(1) is used
    # instead of a `*/` glob so this is robust under zsh's default NOMATCH
    # and POSIX shells; hidden dirs like .git and .envrc.d are filtered out
    # explicitly.
    local sub
    while IFS= read -r sub; do
        sub="${sub#./}"
        [ -n "$sub" ] || continue
        if [ -f "$sub/.envrc" ]; then
            source_env "$PWD/$sub"
        fi
    done < <(find . -mindepth 1 -maxdepth 1 -type d ! -name '.*' 2>/dev/null)
}

_checksum() {
    local file="$1"
    [ -f "$file" ] || return 0
    for cmd in sha256sum sha1sum md5sum; do
        local algo="${cmd%sum}"
        if command -v "$cmd" &>/dev/null; then
            printf '%s: %s\n' "$algo" "$("$cmd" "$file")"
        elif command -v shasum &>/dev/null && [[ "$cmd" == sha256sum ]]; then
            printf '%s: %s\n' "$algo" "$(shasum -a 256 "$file")"
        elif command -v shasum &>/dev/null && [[ "$cmd" == sha1sum ]]; then
            printf '%s: %s\n' "$algo" "$(shasum -a 1 "$file")"
        elif command -v md5 &>/dev/null && [[ "$cmd" == md5sum ]]; then
            printf '%s: %s\n' "$algo" "$(md5 "$file")"
        fi
    done
}

_build_zip() {
    [ -d "bin" ] || return 0
    echo "--- bin/output.zip (before) ---"
    _checksum bin/output.zip
    rm -f bin/output.zip
    echo "--- bin/output.zip (archive) ---"
    # Files reach the bundle by value, including the symlinks that pull
    # individual files out of the resolved dependency trees (helm/, .envrc.d/).
    # A link whose target is missing — the normal state of a dependency that
    # has not been materialised — makes zip print "name not matched" on
    # stdout, skip the file, and still exit 0, so an incomplete bundle looks
    # like a clean build. Scan the transcript instead of trusting the status.
    local archive_log unmatched
    archive_log="$(zip -r "bin/output.zip" . -x@.zipignore)"
    printf '%s\n' "$archive_log"
    unmatched="$(printf '%s\n' "$archive_log" | sed -n 's/.*name not matched: //p')"
    if [ -n "$unmatched" ]; then
        rm -f bin/output.zip
        {
            echo "--- bin/output.zip (incomplete, discarded) ---"
            echo "zip could not read these paths, so they are missing from the bundle:"
            printf '%s\n' "$unmatched" | sed 's/^/  /'
            echo "These are usually symlinks into a dependency declared in ps-bundle.deps.json."
            echo "Fix with: ps_bundle_resolve"
        } >&2
        return 1
    fi
    echo "--- bin/output.zip (after) ---"
    _checksum bin/output.zip
}

_show_deps_summary() {
    command -v ps_bundle_resolve &>/dev/null || return 0

    local plan name version target sentinel missing=0
    plan="$(ps_bundle_resolve --print-plan 2>/dev/null)" || return 0
    [ -n "$plan" ] || return 0

    echo "--- bundle deps ---"
    while IFS="$(printf '\t')" read -r name version target; do
        [ -n "$name" ] || continue
        sentinel="${target%/}/.ps-bundle-version"
        if [ -f "$sentinel" ]; then
            printf '%s %s -> %s/\n' "$name" "$(head -n 1 "$sentinel")" "${target%/}"
        else
            printf '%s %s -> %s/ (missing)\n' "$name" "$version" "${target%/}"
            missing=1
        fi
    done <<deps
$plan
deps

    if [ "$missing" -eq 1 ]; then
        echo "Warning: a declared bundle dependency is not present in this tree." >&2
    fi
}

_show_bundle_upload_guidance() {
    command -v ps_bundle_upload &>/dev/null || return 0

    local bundle_branch
    bundle_branch="$(ps_bundle_upload --print-branch 2>/dev/null)" || return 0

    cat <<help
--- bundle upload ---
Dirty changes were packaged in bin/output.zip.
Default dirty branch: ${bundle_branch}
Upload after JFrog CLI is configured:
    ps_bundle_upload
help
}

if [ "${1:-}" = "-live" ]; then
    # Customer env: put the bundled helpers on PATH, restore +x, and source
    # any opted-in subfolder .envrcs that survived bundling.
    # `jf rt u --explode` strips the Unix file mode server-side, so files
    # arrive as 0644 even though the source zip carries 0755. Re-apply on
    # activation; idempotent if already executable.
    #
    # Subfolder .envrcs that survived bundling commonly use direnv stdlib
    # helpers (source_env, PATH_add, expand_path, ...). The customer's shell
    # has no direnv; supply minimal polyfills so those .envrcs Just Work.
    # Each guard only fires if direnv (or someone else) hasn't already
    # defined the function, so dev mode is untouched.
    if ! command -v PATH_add >/dev/null 2>&1; then
        PATH_add() { export PATH="$1:$PATH"; }
    fi
    if ! command -v expand_path >/dev/null 2>&1; then
        expand_path() {
            local _p="${1:-.}"
            if [ -d "$_p" ]; then
                ( cd "$_p" && pwd )
            else
                ( cd "$(dirname "$_p")" && printf '%s/%s\n' "$(pwd)" "$(basename "$_p")" )
            fi
        }
    fi
    if ! command -v source_env >/dev/null 2>&1; then
        source_env() {
            local _rcpath="$1"
            [ -d "$_rcpath" ] && _rcpath="$_rcpath/.envrc"
            [ -f "$_rcpath" ] || return 0
            local _prev="$PWD"
            cd "$(dirname "$_rcpath")" || return 1
            # shellcheck source=/dev/null
            . "./$(basename "$_rcpath")"
            local _ec=$?
            cd "$_prev" || return $_ec
            return $_ec
        }
    fi
    # source_up_if_exists / watch_file are direnv-only conveniences with no
    # meaningful customer-side equivalent; no-op them so they never error.
    if ! command -v source_up_if_exists >/dev/null 2>&1; then
        source_up_if_exists() { :; }
    fi
    if ! command -v watch_file >/dev/null 2>&1; then
        watch_file() { :; }
    fi

    export PATH="$PWD/.envrc.d:$PATH"
    if [ -d "$PWD/.envrc.d" ]; then
        find "$PWD/.envrc.d" -type f -exec chmod +x {} +
    fi
    _load_subdir_envrcs
    if [ -f "$PWD/.toolbox-bundle.json" ] && command -v jf >/dev/null 2>&1; then
        jf toolbox bundle update --check --dir="$PWD" 2>/dev/null || true
    fi
    # No ps_bundle_resolve here: the deps are already materialised inside the
    # shipped bundle, and the customer's token is scoped to their own bundle
    # subfolder, so it cannot read the shared component folders anyway.
    _show_deps_summary
else
    # Developer env: register helpers via direnv, load any opted-in subfolder
    # .envrcs, materialise declared deps, rebuild the bundle, and surface
    # upload guidance for dirty work.
    source_up_if_exists
    PATH_add .envrc.d
    _load_subdir_envrcs
    # Must precede _build_zip so the resolved dep content lands in the zip.
    if command -v ps_bundle_resolve &>/dev/null; then
        ps_bundle_resolve || return 1
    fi
    _build_zip || return 1
    _show_deps_summary
    _show_bundle_upload_guidance
fi
